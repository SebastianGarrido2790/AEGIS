# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Virtual environments (managed by uv)
.venv/
env/
venv/

# Environment files & secrets (INV-1, INV-10: never commit secrets)
.env*
!.env.example

# IDE & Editor artifacts
.idea/
.vscode/
*.code-workspace
.DS_Store
*.swp
*.swo

# Testing & Linting caches
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# DVC local storage & cache (local-first storage per ADR-007)
.dvc/cache/
.dvc/tmp/
data/
artifacts/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Local logs
logs/
*.log

# MLflow tracking local files
mlruns/
mlflow.db

# Agent Customizations
.agents/
AGENTS.md